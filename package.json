{
  "name": "nexus-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:integration:core": "node --import tsx --loader ./tests/register-server-only-loader.mjs --test tests/integration/core-transaction-idempotency.test.ts",
    "test:integration:locations": "node --import tsx --loader ./tests/register-server-only-loader.mjs --test tests/integration/locations.test.ts",
    "test:integration:booking": "node --import tsx --loader ./tests/register-server-only-loader.mjs --test --test-concurrency=1 tests/integration/restaurant-booking.test.ts tests/integration/restaurant-booking-dashboard.test.ts tests/integration/restaurant-booking-public.test.ts",
    "test:integration:booking-public": "node --import tsx --loader ./tests/register-server-only-loader.mjs --test tests/integration/restaurant-booking-public.test.ts",
    "test:integration:booking-email": "node --import tsx --loader ./tests/register-server-only-loader.mjs --test tests/integration/restaurant-booking-email.test.ts",
    "test:integration:widget": "node --import tsx --loader ./tests/register-server-only-loader.mjs --test --test-concurrency=1 tests/integration/restaurant-booking-widget.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:restaurant": "playwright test tests/e2e/restaurant-core-hardening.spec.ts",
    "test:e2e:locations": "playwright test tests/e2e/locations.spec.ts",
    "test:e2e:booking-public": "SMTP_HOST= SMTP_FROM= playwright test tests/e2e/restaurant-booking-public.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
