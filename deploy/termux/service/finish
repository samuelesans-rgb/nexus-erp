#!/data/data/com.termux/files/usr/bin/sh
STATE="$HOME/.local/state/nexus-kitchen"
started=$(cat "$STATE/started-at" 2>/dev/null || echo 0)
now=$(date +%s)
count=$(cat "$STATE/restart-count" 2>/dev/null || echo 0)

# Rimasto su piu' di 5 minuti: non era un crash loop, si riparte da zero.
if [ "$((now - started))" -gt 300 ]; then count=0; else count=$((count + 1)); fi
[ "$count" -gt 6 ] && count=6
echo "$count" > "$STATE/restart-count"

delay=$((1 << count))   # 1, 2, 4, 8, 16, 32, 64 secondi
echo "[launcher] uscita $1/$2, riavvio fra ${delay}s"
sleep "$delay"
