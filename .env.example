# Runtime
NODE_ENV="production"
PORT="3000"
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/nexus_erp?schema=public"

# Auth.js — public HTTPS origin of the ERP, without a trailing slash
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="https://erp.frisabistro.com"
AUTH_TRUST_HOST="true"

# Public origin serving widget.js, embed pages and Widget API
WIDGET_PUBLIC_ORIGIN="https://erp.frisabistro.com"

# Booking email (omit SMTP_HOST/SMTP_FROM to use the safe noop fallback)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Frisa Bistro <prenotazioni@frisabistro.com>"
BOOKING_NOTIFICATION_EMAIL="prenotazioni@frisabistro.com"

# Open Banking V1.1 (read-only; never commit real credentials)
OPEN_BANKING_PROVIDER="" # mock | enable-banking | yapily | tink
OPEN_BANKING_ENCRYPTION_KEY="" # 32 random bytes encoded as Base64
OPEN_BANKING_CALLBACK_URL="" # e.g. https://erp.example.com/api/open-banking/callback
OPEN_BANKING_ALLOW_MOCK="false" # development only; always rejected in production

ENABLE_BANKING_CLIENT_ID=""
ENABLE_BANKING_CLIENT_SECRET=""
ENABLE_BANKING_BASE_URL=""
ENABLE_BANKING_SANDBOX="true"
ENABLE_BANKING_BNL_INSTITUTION_ID=""
ENABLE_BANKING_INTESA_INSTITUTION_ID=""

YAPILY_APPLICATION_KEY=""
YAPILY_APPLICATION_SECRET=""
YAPILY_SANDBOX="true"
YAPILY_BNL_INSTITUTION_ID=""
YAPILY_INTESA_INSTITUTION_ID=""

TINK_CLIENT_ID=""
TINK_CLIENT_SECRET=""
TINK_SANDBOX="true"
TINK_BNL_INSTITUTION_ID=""
TINK_INTESA_INSTITUTION_ID=""
