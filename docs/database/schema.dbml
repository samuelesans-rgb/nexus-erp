Project NexusERP {
  database_type: "PostgreSQL"
}

Enum PartnerType {
  COMPANY
  PERSON
}

Enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

Enum ModuleCategory {
  CORE
  SHARED
  RESTAURANT
  BEAUTY
  HOTEL
}

Enum ModuleStatus {
  AVAILABLE
  PLANNED
  FUTURE
}

Table Company {
  id varchar [pk]
  name varchar [not null]
  legalName varchar
  vatNumber varchar [unique]
  taxCode varchar
  email varchar
  phone varchar
  address varchar
  city varchar
  country varchar
  currency varchar [not null, default: "EUR"]
  timezone varchar [not null, default: "Europe/Rome"]
  locale varchar [not null, default: "it-IT"]
  active boolean [not null, default: true]
  logo varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table User {
  id varchar [pk]
  firstName varchar [not null]
  lastName varchar [not null]
  email varchar [not null, unique]
  password varchar [not null]
  active boolean [not null, default: true]
  emailVerified timestamp
  image varchar
  lastLogin timestamp
  locale varchar [not null, default: "it-IT"]
  timeZone varchar [not null, default: "Europe/Rome"]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table Membership {
  id varchar [pk]
  userId varchar [not null, ref: > User.id]
  companyId varchar [not null, ref: > Company.id]
  active boolean [not null, default: true]
  isDefault boolean [not null, default: false]
  joinedAt timestamp [not null]

  indexes {
    (userId, companyId) [unique]
  }
}

Table Role {
  id varchar [pk]
  code varchar [not null, unique]
  name varchar [not null]
  description varchar
  system boolean [not null, default: true]
}

Table MembershipRole {
  membershipId varchar [not null, ref: > Membership.id]
  roleId varchar [not null, ref: > Role.id]

  indexes {
    (membershipId, roleId) [pk]
  }
}

Table Account {
  id varchar [pk]
  userId varchar [not null, ref: > User.id]
  type varchar [not null]
  provider varchar [not null]
  providerAccountId varchar [not null]
  refresh_token varchar
  access_token varchar
  expires_at int
  token_type varchar
  scope varchar
  id_token varchar
  session_state varchar

  indexes {
    (provider, providerAccountId) [unique]
  }
}

Table Session {
  id varchar [pk]
  sessionToken varchar [not null, unique]
  userId varchar [not null, ref: > User.id]
  expires timestamp [not null]
}

Table VerificationToken {
  identifier varchar [not null]
  token varchar [not null, unique]
  expires timestamp [not null]

  indexes {
    (identifier, token) [unique]
  }
}

Table Partner {
  id varchar [pk]
  code varchar [not null]
  type PartnerType [not null, default: "COMPANY"]
  status PartnerStatus [not null, default: "ACTIVE"]
  name varchar [not null]
  displayName varchar
  legalName varchar
  firstName varchar
  lastName varchar
  vatNumber varchar
  taxCode varchar
  email varchar
  pec varchar
  phone varchar
  mobile varchar
  website varchar
  address varchar
  zipCode varchar
  city varchar
  province varchar
  country varchar
  isCustomer boolean [not null, default: false]
  isSupplier boolean [not null, default: false]
  isLead boolean [not null, default: false]
  isProspect boolean [not null, default: false]
  isCollaborator boolean [not null, default: false]
  isAgent boolean [not null, default: false]
  isCarrier boolean [not null, default: false]
  isProfessional boolean [not null, default: false]
  category varchar
  priceListCode varchar
  paymentMethod varchar
  paymentTerms varchar
  creditLimit decimal(15,2)
  discountPercent decimal(5,2)
  recipientCode varchar
  splitPayment boolean [not null, default: false]
  reverseCharge boolean [not null, default: false]
  internalNotes text
  active boolean [not null, default: true]
  deletedAt timestamp
  companyId varchar [not null, ref: > Company.id]
  agentId varchar [ref: > Partner.id]
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, code) [unique]
    (companyId, active, deletedAt)
    (companyId, type)
    (companyId, category)
    (companyId, name)
    (companyId, vatNumber)
    (companyId, taxCode)
    agentId
  }
}

Table ModuleDefinition {
  id varchar [pk]
  code varchar [not null, unique]
  name varchar [not null]
  description varchar
  category ModuleCategory [not null]
  mandatory boolean [not null, default: false]
  status ModuleStatus [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CompanyModule {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  moduleDefinitionId varchar [not null, ref: > ModuleDefinition.id]
  enabled boolean [not null, default: false]
  enabledAt timestamp
  disabledAt timestamp
  configuration json
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, moduleDefinitionId) [unique]
    (companyId, enabled)
    moduleDefinitionId
  }
}
