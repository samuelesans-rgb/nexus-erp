Project NexusERP {
  database_type: "PostgreSQL"
}

Table RestaurantArea { id varchar [pk] companyId varchar [not null, ref: > Company.id] locationId varchar [not null, ref: > Location.id] code varchar [not null] name varchar [not null] active boolean [not null] deletedAt timestamp indexes { (companyId, locationId, code) [unique] } }
Table RestaurantTable { id varchar [pk] companyId varchar [not null, ref: > Company.id] locationId varchar [not null, ref: > Location.id] areaId varchar [not null, ref: > RestaurantArea.id] code varchar [not null] name varchar [not null] seats int [not null] status varchar [not null] deletedAt timestamp indexes { (companyId, locationId, code) [unique] } }
Table RestaurantReservation { id varchar [pk] companyId varchar [not null, ref: > Company.id] locationId varchar [not null, ref: > Location.id] code varchar [not null] partnerId varchar [ref: > Partner.id] guestName varchar [not null] startTime timestamp [not null] partySize int [not null] status varchar [not null] depositScheduleId varchar [ref: > PaymentSchedule.id] indexes { (companyId, code) [unique] } }
Table RestaurantReservationTable { companyId varchar [not null, ref: > Company.id] reservationId varchar [not null, ref: > RestaurantReservation.id] tableId varchar [not null, ref: > RestaurantTable.id] indexes { (companyId, reservationId, tableId) [pk] } }
Table RestaurantMenu { id varchar [pk] companyId varchar [not null, ref: > Company.id] locationId varchar [ref: > Location.id] code varchar [not null] name varchar [not null] active boolean [not null] indexes { (companyId, code) [unique] } }
Table RestaurantMenuSection { id varchar [pk] companyId varchar [not null, ref: > Company.id] menuId varchar [not null, ref: > RestaurantMenu.id] name varchar [not null] sortOrder int [not null] }
Table RestaurantMenuItem { id varchar [pk] companyId varchar [not null, ref: > Company.id] menuSectionId varchar [not null, ref: > RestaurantMenuSection.id] itemId varchar [not null, ref: > Item.id] priceOverride decimal available boolean [not null] }
Table RestaurantOrder { id varchar [pk] companyId varchar [not null, ref: > Company.id] locationId varchar [not null, ref: > Location.id] code varchar [not null] tableId varchar [ref: > RestaurantTable.id] partnerId varchar [ref: > Partner.id] status varchar [not null] documentId varchar [ref: > BusinessDocument.id] paymentStatus varchar [not null] indexes { (companyId, locationId, code) [unique] } }
Table RestaurantOrderLine { id varchar [pk] companyId varchar [not null, ref: > Company.id] orderId varchar [not null, ref: > RestaurantOrder.id] itemId varchar [not null, ref: > Item.id] quantity decimal [not null] unitPrice decimal [not null] vatRateId varchar [not null, ref: > VatRate.id] status varchar [not null] }
Table RestaurantOrderLineModifier { id varchar [pk] companyId varchar [not null, ref: > Company.id] orderLineId varchar [not null, ref: > RestaurantOrderLine.id] itemId varchar [ref: > Item.id] name varchar [not null] priceDelta decimal [not null] }
Table KitchenStation { id varchar [pk] companyId varchar [not null, ref: > Company.id] locationId varchar [not null, ref: > Location.id] code varchar [not null] name varchar [not null] indexes { (companyId, locationId, code) [unique] } }
Table KitchenStationAssignment { id varchar [pk] companyId varchar [not null, ref: > Company.id] kitchenStationId varchar [not null, ref: > KitchenStation.id] itemId varchar [ref: > Item.id] itemCategoryId varchar [ref: > ItemCategory.id] priority int [not null] }
Table KitchenTicket { id varchar [pk] companyId varchar [not null, ref: > Company.id] locationId varchar [not null, ref: > Location.id] kitchenStationId varchar [not null, ref: > KitchenStation.id] orderId varchar [not null, ref: > RestaurantOrder.id] status varchar [not null] }
Table KitchenTicketLine { id varchar [pk] companyId varchar [not null, ref: > Company.id] ticketId varchar [not null, ref: > KitchenTicket.id] orderLineId varchar [not null, ref: > RestaurantOrderLine.id] status varchar [not null] }
Table RecipeConsumption { id varchar [pk] companyId varchar [not null, ref: > Company.id] locationId varchar [not null, ref: > Location.id] orderId varchar [not null, ref: > RestaurantOrder.id] orderLineId varchar [not null, ref: > RestaurantOrderLine.id] recipeItemId varchar [not null, ref: > Item.id] componentItemId varchar [not null, ref: > Item.id] inventoryMovementId varchar [not null, ref: > InventoryMovement.id] quantity decimal [not null] indexes { (companyId, orderLineId, componentItemId) [unique] } }

Enum PartnerType {
  COMPANY
  PERSON
}

Enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

Enum ItemType {
  PRODUCT
  SERVICE
  INGREDIENT
  RECIPE
  BEAUTY_SERVICE
  HOTEL_ROOM
  PACKAGE
  GIFT_CARD
}

Enum ItemStatus {
  ACTIVE
  SUSPENDED
}

Enum ModuleCategory {
  CORE
  SHARED
  RESTAURANT
  BEAUTY
  HOTEL
}

Enum ModuleStatus {
  AVAILABLE
  PLANNED
  FUTURE
}

Table Company {
  id varchar [pk]
  name varchar [not null]
  legalName varchar
  vatNumber varchar [unique]
  taxCode varchar
  email varchar
  phone varchar
  address varchar
  city varchar
  country varchar
  currency varchar [not null, default: "EUR"]
  timezone varchar [not null, default: "Europe/Rome"]
  locale varchar [not null, default: "it-IT"]
  active boolean [not null, default: true]
  logo varchar
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table User {
  id varchar [pk]
  firstName varchar [not null]
  lastName varchar [not null]
  email varchar [not null, unique]
  password varchar [not null]
  active boolean [not null, default: true]
  emailVerified timestamp
  image varchar
  lastLogin timestamp
  locale varchar [not null, default: "it-IT"]
  timeZone varchar [not null, default: "Europe/Rome"]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table Membership {
  id varchar [pk]
  userId varchar [not null, ref: > User.id]
  companyId varchar [not null, ref: > Company.id]
  active boolean [not null, default: true]
  isDefault boolean [not null, default: false]
  joinedAt timestamp [not null]

  indexes {
    (userId, companyId) [unique]
  }
}

Table Role {
  id varchar [pk]
  code varchar [not null, unique]
  name varchar [not null]
  description varchar
  system boolean [not null, default: true]
}

Table MembershipRole {
  membershipId varchar [not null, ref: > Membership.id]
  roleId varchar [not null, ref: > Role.id]

  indexes {
    (membershipId, roleId) [pk]
  }
}

Table Account {
  id varchar [pk]
  userId varchar [not null, ref: > User.id]
  type varchar [not null]
  provider varchar [not null]
  providerAccountId varchar [not null]
  refresh_token varchar
  access_token varchar
  expires_at int
  token_type varchar
  scope varchar
  id_token varchar
  session_state varchar

  indexes {
    (provider, providerAccountId) [unique]
  }
}

Table Session {
  id varchar [pk]
  sessionToken varchar [not null, unique]
  userId varchar [not null, ref: > User.id]
  expires timestamp [not null]
}

Table VerificationToken {
  identifier varchar [not null]
  token varchar [not null, unique]
  expires timestamp [not null]

  indexes {
    (identifier, token) [unique]
  }
}

Table Partner {
  id varchar [pk]
  code varchar [not null]
  type PartnerType [not null, default: "COMPANY"]
  status PartnerStatus [not null, default: "ACTIVE"]
  name varchar [not null]
  displayName varchar
  legalName varchar
  firstName varchar
  lastName varchar
  vatNumber varchar
  taxCode varchar
  email varchar
  pec varchar
  phone varchar
  mobile varchar
  website varchar
  address varchar
  zipCode varchar
  city varchar
  province varchar
  country varchar
  isCustomer boolean [not null, default: false]
  isSupplier boolean [not null, default: false]
  isLead boolean [not null, default: false]
  isProspect boolean [not null, default: false]
  isCollaborator boolean [not null, default: false]
  isAgent boolean [not null, default: false]
  isCarrier boolean [not null, default: false]
  isProfessional boolean [not null, default: false]
  category varchar
  priceListId varchar [ref: > PriceList.id]
  paymentMethodId varchar [ref: > PaymentMethod.id]
  paymentTermId varchar [ref: > PaymentTerm.id]
  creditLimit decimal(15,2)
  discountPercent decimal(5,2)
  recipientCode varchar
  splitPayment boolean [not null, default: false]
  reverseCharge boolean [not null, default: false]
  internalNotes text
  active boolean [not null, default: true]
  deletedAt timestamp
  companyId varchar [not null, ref: > Company.id]
  agentId varchar [ref: > Partner.id]
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, code) [unique]
    (companyId, active, deletedAt)
    (companyId, type)
    (companyId, category)
    (companyId, name)
    (companyId, vatNumber)
    (companyId, taxCode)
    agentId
  }
}

Table ModuleDefinition {
  id varchar [pk]
  code varchar [not null, unique]
  name varchar [not null]
  description varchar
  category ModuleCategory [not null]
  mandatory boolean [not null, default: false]
  status ModuleStatus [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
}

Table CompanyModule {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  moduleDefinitionId varchar [not null, ref: > ModuleDefinition.id]
  enabled boolean [not null, default: false]
  enabledAt timestamp
  disabledAt timestamp
  configuration json
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, moduleDefinitionId) [unique]
    (companyId, enabled)
    moduleDefinitionId
  }
}

Table ItemCategory {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  description text
  parentId varchar [ref: > ItemCategory.id]
  active boolean [not null, default: true]
  deletedAt timestamp
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, code) [unique]
    (companyId, id) [unique]
    (companyId, active, deletedAt)
    (companyId, parentId)
  }
}

Table UnitOfMeasure {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  description text
  symbol varchar [not null]
  precision int [not null, default: 2]
  active boolean [not null, default: true]
  deletedAt timestamp
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, code) [unique]
    (companyId, id) [unique]
    (companyId, active, deletedAt)
  }
}

Table VatRate {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  description text
  percentage decimal(5,2) [not null]
  natureCode varchar
  active boolean [not null, default: true]
  validFrom timestamp
  validTo timestamp
  deletedAt timestamp
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, code) [unique]
    (companyId, id) [unique]
    (companyId, active, deletedAt)
  }
}

Table PriceList {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  description text
  currency varchar [not null, default: "EUR"]
  active boolean [not null, default: true]
  deletedAt timestamp
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes {
    (companyId, code) [unique]
    (companyId, id) [unique]
    (companyId, active, deletedAt)
  }
}

Table PriceListItem {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  priceListId varchar [not null, ref: > PriceList.id]
  itemId varchar [not null, ref: > Item.id]
  price decimal(15,2) [not null]
  active boolean [not null, default: true]
  deletedAt timestamp
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes {
    (companyId, priceListId, itemId) [unique]
    (companyId, itemId, deletedAt)
  }
}

Table PaymentMethod {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  description text
  active boolean [not null, default: true]
  deletedAt timestamp
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes {
    (companyId, code) [unique]
    (companyId, id) [unique]
    (companyId, active, deletedAt)
  }
}

Table PaymentTerm {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  description text
  dueDays int
  endOfMonth boolean [not null, default: false]
  installments json
  active boolean [not null, default: true]
  deletedAt timestamp
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes {
    (companyId, code) [unique]
    (companyId, id) [unique]
    (companyId, active, deletedAt)
  }
}

Table Item {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  type ItemType [not null]
  status ItemStatus [not null, default: "ACTIVE"]
  active boolean [not null, default: true]
  name varchar [not null]
  shortName varchar
  description text
  internalNotes text
  barcode varchar
  sku varchar
  imageUrl varchar
  categoryId varchar [ref: > ItemCategory.id]
  unitOfMeasureId varchar [ref: > UnitOfMeasure.id]
  vatRateId varchar [ref: > VatRate.id]
  salePrice decimal(15,2)
  purchasePrice decimal(15,2)
  standardCost decimal(15,2)
  currency varchar [not null, default: "EUR"]
  sellable boolean [not null, default: true]
  purchasable boolean [not null, default: false]
  stockManaged boolean [not null, default: false]
  trackLots boolean [not null, default: false]
  trackSerials boolean [not null, default: false]
  trackExpiration boolean [not null, default: false]
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  deletedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, code) [unique]
    (companyId, id) [unique]
    (companyId, active, deletedAt)
    (companyId, type)
    (companyId, categoryId)
    (companyId, name)
    (companyId, sku)
    (companyId, barcode)
  }
}

Table ProductProfile {
  itemId varchar [pk, ref: > Item.id]
  companyId varchar [not null, ref: > Company.id]
  weight decimal(15,3)
  dimensions json
  manufacturer varchar
  brand varchar
  reorderPoint decimal(15,3)
  minimumStock decimal(15,3)
}

Table ServiceProfile {
  itemId varchar [pk, ref: > Item.id]
  companyId varchar [not null, ref: > Company.id]
  durationMinutes int
  requiresAppointment boolean [not null, default: false]
  defaultCapacity int
}

Table IngredientProfile {
  itemId varchar [pk, ref: > Item.id]
  companyId varchar [not null, ref: > Company.id]
  yieldPercentage decimal(5,2)
  storageInstructions text
  allergenNotes text
  perishabilityDays int
}

Table RecipeProfile {
  itemId varchar [pk, ref: > Item.id]
  companyId varchar [not null, ref: > Company.id]
  preparationMinutes int
  portions decimal(15,3)
  yieldQuantity decimal(15,3)
  instructions text
  foodCostTarget decimal(5,2)
}

Table RecipeComponent {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  recipeItemId varchar [not null, ref: > Item.id]
  componentItemId varchar [not null, ref: > Item.id]
  unitOfMeasureId varchar [not null, ref: > UnitOfMeasure.id]
  quantity decimal(15,3) [not null]
  wastePercentage decimal(5,2)
  sortOrder int [not null, default: 0]
  deletedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, recipeItemId, componentItemId) [unique]
    (companyId, recipeItemId, deletedAt)
    (companyId, componentItemId)
  }
}

Table BeautyServiceProfile {
  itemId varchar [pk, ref: > Item.id]
  companyId varchar [not null, ref: > Company.id]
  durationMinutes int [not null]
  cleanupMinutes int
  requiresCabin boolean [not null, default: false]
  requiresOperator boolean [not null, default: true]
  recommendedRepeatDays int
  consentRequired boolean [not null, default: false]
}

Table HotelRoomProfile {
  itemId varchar [pk, ref: > Item.id]
  companyId varchar [not null, ref: > Company.id]
  capacityAdults int [not null, default: 1]
  capacityChildren int [not null, default: 0]
  roomTypeCode varchar
  physicalRoomCode varchar
  floor varchar
  sellableUnit boolean [not null, default: true]
  housekeepingRequired boolean [not null, default: true]
}

Table PackageProfile {
  itemId varchar [pk, ref: > Item.id]
  companyId varchar [not null, ref: > Company.id]
  validityDays int
  usageLimit int
}

Table PackageComponent {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  packageItemId varchar [not null, ref: > Item.id]
  componentItemId varchar [not null, ref: > Item.id]
  unitOfMeasureId varchar [not null, ref: > UnitOfMeasure.id]
  quantity decimal(15,3) [not null]
  sortOrder int [not null, default: 0]
  deletedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    (companyId, packageItemId, componentItemId) [unique]
    (companyId, packageItemId, deletedAt)
    (companyId, componentItemId)
  }
}

Table GiftCardProfile {
  itemId varchar [pk, ref: > Item.id]
  companyId varchar [not null, ref: > Company.id]
  defaultValidityDays int [not null]
  fixedValue decimal(15,2)
  reusable boolean [not null, default: false]
  transferable boolean [not null, default: true]
}

Table Location {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  address varchar
  city varchar
  active boolean [not null, default: true]
  deletedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, code) [unique] (companyId, id) [unique] }
}

Table Warehouse {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  locationId varchar [not null, ref: > Location.id]
  code varchar [not null]
  name varchar [not null]
  description text
  active boolean [not null, default: true]
  allowNegativeStock boolean [not null, default: false]
  deletedAt timestamp
  createdById varchar [ref: > User.id]
  updatedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, code) [unique] (companyId, id) [unique] }
}

Table WarehouseBin {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  warehouseId varchar [not null, ref: > Warehouse.id]
  code varchar [not null]
  name varchar [not null]
  description text
  binType varchar
  active boolean [not null, default: true]
  deletedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, warehouseId, code) [unique] (companyId, id) [unique] }
}

Table InventoryLot {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  itemId varchar [not null, ref: > Item.id]
  lotNumber varchar [not null]
  manufactureDate timestamp
  expirationDate timestamp
  supplierLot varchar
  active boolean [not null, default: true]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, itemId, lotNumber) [unique] (companyId, id) [unique] }
}

Table InventorySerial {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  itemId varchar [not null, ref: > Item.id]
  serialNumber varchar [not null]
  status varchar [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, serialNumber) [unique] (companyId, id) [unique] }
}

Table InventoryMovement {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  warehouseId varchar [not null, ref: > Warehouse.id]
  binId varchar [ref: > WarehouseBin.id]
  itemId varchar [not null, ref: > Item.id]
  movementType varchar [not null]
  quantity decimal(15,3) [not null]
  direction int [not null]
  unitOfMeasureId varchar [not null, ref: > UnitOfMeasure.id]
  lotId varchar [ref: > InventoryLot.id]
  serialId varchar [ref: > InventorySerial.id]
  unitCost decimal(15,4)
  totalCost decimal(15,2)
  referenceType varchar
  referenceId varchar
  reason text
  note text
  occurredAt timestamp [not null]
  postedAt timestamp [not null]
  postedById varchar [not null, ref: > User.id]
  reversalOfId varchar [unique, ref: > InventoryMovement.id]
  createdAt timestamp [not null]
  indexes { (companyId, occurredAt) (companyId, warehouseId, itemId, occurredAt) }
}

Table InventoryTransfer {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  sourceWarehouseId varchar [not null, ref: > Warehouse.id]
  destinationWarehouseId varchar [not null, ref: > Warehouse.id]
  sourceBinId varchar [ref: > WarehouseBin.id]
  destinationBinId varchar [ref: > WarehouseBin.id]
  status varchar [not null]
  requestedAt timestamp [not null]
  completedAt timestamp
  completedById varchar [ref: > User.id]
  createdById varchar [not null, ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, code) [unique] (companyId, id) [unique] }
}

Table InventoryTransferLine {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  transferId varchar [not null, ref: > InventoryTransfer.id]
  itemId varchar [not null, ref: > Item.id]
  quantity decimal(15,3) [not null]
  unitOfMeasureId varchar [not null, ref: > UnitOfMeasure.id]
  lotId varchar [ref: > InventoryLot.id]
  serialId varchar [ref: > InventorySerial.id]
}

Table InventoryCount {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  warehouseId varchar [not null, ref: > Warehouse.id]
  binId varchar [ref: > WarehouseBin.id]
  status varchar [not null]
  countedAt timestamp
  postedAt timestamp
  postedById varchar [ref: > User.id]
  createdById varchar [not null, ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, code) [unique] (companyId, id) [unique] }
}

Table InventoryCountLine {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  inventoryCountId varchar [not null, ref: > InventoryCount.id]
  itemId varchar [not null, ref: > Item.id]
  expectedQuantity decimal(15,3) [not null]
  countedQuantity decimal(15,3) [not null]
  difference decimal(15,3) [not null]
  unitOfMeasureId varchar [not null, ref: > UnitOfMeasure.id]
  lotId varchar [ref: > InventoryLot.id]
  serialId varchar [ref: > InventorySerial.id]
}

Table StockBalance {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  warehouseId varchar [not null, ref: > Warehouse.id]
  itemId varchar [not null, ref: > Item.id]
  quantity decimal(15,3) [not null]
  averageCost decimal(15,4) [not null]
  stockValue decimal(15,2) [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, warehouseId, itemId) [unique] (companyId, itemId) }
}

Table DomainEvent {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  eventType varchar [not null]
  aggregateType varchar [not null]
  aggregateId varchar [not null]
  payload json [not null]
  occurredAt timestamp [not null]
  processedAt timestamp
  createdAt timestamp [not null]
  indexes { (processedAt, occurredAt) (companyId, eventType, occurredAt) }
}

Table DocumentSeries {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  documentType varchar [not null]
  prefix varchar [not null]
  suffix varchar [not null]
  nextNumber int [not null, default: 1]
  padding int [not null, default: 6]
  active boolean [not null, default: true]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, code) [unique] (companyId, id) [unique] }
}

Table BusinessDocument {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  seriesId varchar [not null, ref: > DocumentSeries.id]
  documentNumber varchar [not null]
  documentType varchar [not null]
  status varchar [not null]
  partnerId varchar [not null, ref: > Partner.id]
  documentDate timestamp [not null]
  postingDate timestamp
  currency varchar [not null]
  exchangeRate decimal(18,6) [not null]
  warehouseId varchar [ref: > Warehouse.id]
  locationId varchar [ref: > Location.id]
  paymentMethodId varchar [ref: > PaymentMethod.id]
  paymentTermId varchar [ref: > PaymentTerm.id]
  priceListId varchar [ref: > PriceList.id]
  subtotal decimal(15,2) [not null]
  discount decimal(15,2) [not null]
  tax decimal(15,2) [not null]
  total decimal(15,2) [not null]
  notes text
  internalNotes text
  createdById varchar [not null, ref: > User.id]
  updatedById varchar [not null, ref: > User.id]
  deletedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, seriesId, documentNumber) [unique] (companyId, id) [unique] }
}

Table BusinessDocumentLine {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  documentId varchar [not null, ref: > BusinessDocument.id]
  lineNumber int [not null]
  itemId varchar [not null, ref: > Item.id]
  description text [not null]
  quantity decimal(15,3) [not null]
  unitOfMeasureId varchar [not null, ref: > UnitOfMeasure.id]
  unitPrice decimal(15,4) [not null]
  discount decimal(5,2) [not null]
  vatRateId varchar [not null, ref: > VatRate.id]
  lineTotal decimal(15,2) [not null]
  warehouseId varchar [ref: > Warehouse.id]
  lotId varchar [ref: > InventoryLot.id]
  serialId varchar [ref: > InventorySerial.id]
  notes text
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, documentId, lineNumber) [unique] (companyId, itemId) }
}

Table DocumentAttachment {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  documentId varchar [not null, ref: > BusinessDocument.id]
  fileName varchar [not null]
  contentType varchar
  storageKey varchar
  metadata json
  createdAt timestamp [not null]
  indexes { (companyId, documentId) }
}

Table DocumentEvent {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  documentId varchar [not null, ref: > BusinessDocument.id]
  eventType varchar [not null]
  fromStatus varchar
  toStatus varchar
  payload json
  createdById varchar [not null, ref: > User.id]
  createdAt timestamp [not null]
  indexes { (companyId, documentId, createdAt) }
}

Enum DocumentLinkType {
  QUOTE_TO_ORDER
  ORDER_TO_DDT
  DDT_TO_INVOICE
  ORDER_TO_INVOICE
  RETURN_TO_CREDIT_NOTE
  PURCHASE_ORDER_TO_RECEIPT
  RECEIPT_TO_PURCHASE_INVOICE
  PURCHASE_ORDER_TO_PURCHASE_INVOICE
  RECEIPT_TO_PURCHASE_RETURN
  PURCHASE_RETURN_TO_CREDIT_NOTE
}

Table DocumentLink {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  sourceDocumentId varchar [not null, ref: > BusinessDocument.id]
  targetDocumentId varchar [not null, ref: > BusinessDocument.id]
  linkType DocumentLinkType [not null]
  createdById varchar [not null, ref: > User.id]
  createdAt timestamp [not null]
  indexes {
    (companyId, sourceDocumentId, targetDocumentId, linkType) [unique]
    (companyId, sourceDocumentId, createdAt)
    (companyId, targetDocumentId, createdAt)
  }
}

Enum FinancialAccountType {
  BANK
  CASH
  CARD
  PAYPAL
  OTHER
}
Enum PaymentScheduleDirection {
  RECEIVABLE
  PAYABLE
}
Enum PaymentScheduleStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}
Enum FinancialMovementType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  TRANSFER_OUT
  TRANSFER_IN
  FEE
  INTEREST
  REFUND_IN
  REFUND_OUT
  OPENING
  ADJUSTMENT
  REVERSAL
}
Enum FinancialMovementDirection {
  IN
  OUT
}
Enum FinancialTransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}
Enum BankStatementStatus {
  IMPORTED
  PARTIALLY_RECONCILED
  RECONCILED
}
Enum ReconciliationStatus {
  UNMATCHED
  MATCHED
}

Table FinancialAccount {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  code varchar [not null]
  name varchar [not null]
  type FinancialAccountType [not null]
  currency varchar [not null, default: "EUR"]
  iban varchar
  bic varchar
  bankName varchar
  openingBalance decimal [not null, default: 0]
  allowOverdraft boolean [not null, default: false]
  active boolean [not null, default: true]
  deletedAt timestamp
  createdById varchar [not null, ref: > User.id]
  updatedById varchar [not null, ref: > User.id]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, code) [unique] (companyId, id) [unique] }
}

Table PaymentSchedule {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  partnerId varchar [not null, ref: > Partner.id]
  documentId varchar [ref: > BusinessDocument.id]
  installmentNumber int [not null, default: 1]
  documentType DocumentType
  direction PaymentScheduleDirection [not null]
  dueDate timestamp [not null]
  amount decimal [not null]
  residualAmount decimal [not null]
  currency varchar [not null, default: "EUR"]
  status PaymentScheduleStatus [not null]
  paymentMethodId varchar [ref: > PaymentMethod.id]
  paymentTermId varchar [ref: > PaymentTerm.id]
  notes varchar
  createdById varchar [not null, ref: > User.id]
  updatedById varchar [not null, ref: > User.id]
  deletedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, documentId, installmentNumber) [unique] (companyId, id) [unique] (companyId, direction, status, dueDate) }
}

Table FinancialMovement {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  financialAccountId varchar [not null, ref: > FinancialAccount.id]
  partnerId varchar [ref: > Partner.id]
  paymentScheduleId varchar [ref: > PaymentSchedule.id]
  documentId varchar [ref: > BusinessDocument.id]
  movementType FinancialMovementType [not null]
  direction FinancialMovementDirection [not null]
  amount decimal [not null]
  currency varchar [not null]
  exchangeRate decimal [not null]
  occurredAt timestamp [not null]
  valueDate timestamp
  reference varchar
  notes varchar
  postedAt timestamp [not null]
  postedById varchar [not null, ref: > User.id]
  reversalOfId varchar [unique, ref: > FinancialMovement.id]
  createdAt timestamp [not null]
  indexes { (companyId, id) [unique] (companyId, financialAccountId, occurredAt) }
}

Table FinancialAllocation {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  movementId varchar [not null, ref: > FinancialMovement.id]
  scheduleId varchar [not null, ref: > PaymentSchedule.id]
  amount decimal [not null]
  reversedAt timestamp
  createdAt timestamp [not null]
  indexes { (companyId, movementId, scheduleId) [unique] }
}

Table FinancialTransfer {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  sourceAccountId varchar [not null, ref: > FinancialAccount.id]
  destinationAccountId varchar [not null, ref: > FinancialAccount.id]
  amount decimal [not null]
  currency varchar [not null]
  transferDate timestamp [not null]
  status FinancialTransferStatus [not null]
  createdById varchar [not null, ref: > User.id]
  completedById varchar [ref: > User.id]
  createdAt timestamp [not null]
  completedAt timestamp
  indexes { (companyId, id) [unique] }
}

Table BankStatement {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  financialAccountId varchar [not null, ref: > FinancialAccount.id]
  statementDate timestamp [not null]
  openingBalance decimal [not null]
  closingBalance decimal [not null]
  status BankStatementStatus [not null]
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  indexes { (companyId, financialAccountId, statementDate) [unique] (companyId, id) [unique] }
}

Table BankStatementLine {
  id varchar [pk]
  companyId varchar [not null, ref: > Company.id]
  bankStatementId varchar [not null, ref: > BankStatement.id]
  transactionDate timestamp [not null]
  valueDate timestamp
  amount decimal [not null]
  description varchar [not null]
  reference varchar
  matchedMovementId varchar [ref: > FinancialMovement.id]
  reconciliationStatus ReconciliationStatus [not null]
  createdAt timestamp [not null]
  indexes { (companyId, id) [unique] (companyId, matchedMovementId) [unique] }
}
