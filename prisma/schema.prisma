generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PartnerType {
  COMPANY
  PERSON
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum ItemType {
  PRODUCT
  SERVICE
  INGREDIENT
  RECIPE
  BEAUTY_SERVICE
  HOTEL_ROOM
  PACKAGE
  GIFT_CARD
}

enum ItemStatus {
  ACTIVE
  SUSPENDED
}

enum ModuleCategory {
  CORE
  SHARED
  RESTAURANT
  BEAUTY
  HOTEL
}

enum ModuleStatus {
  AVAILABLE
  PLANNED
  FUTURE
}

enum InventoryMovementType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  INVENTORY_GAIN
  INVENTORY_LOSS
  CONSUMPTION
  PRODUCTION
  RETURN_IN
  RETURN_OUT
  REVERSAL
}

enum InventorySerialStatus {
  AVAILABLE
  RESERVED
  ISSUED
  BLOCKED
}

enum InventoryTransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InventoryCountStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  vatNumber String? @unique
  taxCode   String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  currency  String  @default("EUR")
  timezone  String  @default("Europe/Rome")
  locale    String  @default("it-IT")
  active    Boolean @default(true)
  logo      String?

  memberships            Membership[]
  partners               Partner[]
  modules                CompanyModule[]
  items                  Item[]
  itemCategories         ItemCategory[]
  unitsOfMeasure         UnitOfMeasure[]
  vatRates               VatRate[]
  priceLists             PriceList[]
  priceListItems         PriceListItem[]
  paymentMethods         PaymentMethod[]
  paymentTerms           PaymentTerm[]
  locations              Location[]
  warehouses             Warehouse[]
  warehouseBins          WarehouseBin[]
  inventoryLots          InventoryLot[]
  inventorySerials       InventorySerial[]
  inventoryMovements     InventoryMovement[]
  inventoryTransfers     InventoryTransfer[]
  inventoryTransferLines InventoryTransferLine[]
  inventoryCounts        InventoryCount[]
  inventoryCountLines    InventoryCountLine[]
  stockBalances          StockBalance[]
  domainEvents           DomainEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModuleDefinition {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  category    ModuleCategory
  mandatory   Boolean        @default(false)
  status      ModuleStatus

  companies CompanyModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyModule {
  id String @id @default(cuid())

  companyId          String
  moduleDefinitionId String
  enabled            Boolean   @default(false)
  enabledAt          DateTime?
  disabledAt         DateTime?
  configuration      Json?

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  moduleDefinition ModuleDefinition @relation(fields: [moduleDefinitionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleDefinitionId])
  @@index([companyId, enabled])
  @@index([moduleDefinitionId])
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  active Boolean @default(true)

  emailVerified DateTime?
  image         String?
  lastLogin     DateTime?

  locale   String @default("it-IT")
  timeZone String @default("Europe/Rome")

  memberships              Membership[]
  partnersCreated          Partner[]           @relation("PartnerCreatedBy")
  partnersUpdated          Partner[]           @relation("PartnerUpdatedBy")
  itemsCreated             Item[]              @relation("ItemCreatedBy")
  itemsUpdated             Item[]              @relation("ItemUpdatedBy")
  itemCategoriesCreated    ItemCategory[]      @relation("ItemCategoryCreatedBy")
  itemCategoriesUpdated    ItemCategory[]      @relation("ItemCategoryUpdatedBy")
  unitsCreated             UnitOfMeasure[]     @relation("UnitOfMeasureCreatedBy")
  unitsUpdated             UnitOfMeasure[]     @relation("UnitOfMeasureUpdatedBy")
  vatRatesCreated          VatRate[]           @relation("VatRateCreatedBy")
  vatRatesUpdated          VatRate[]           @relation("VatRateUpdatedBy")
  priceListsCreated        PriceList[]         @relation("PriceListCreatedBy")
  priceListsUpdated        PriceList[]         @relation("PriceListUpdatedBy")
  priceListItemsCreated    PriceListItem[]     @relation("PriceListItemCreatedBy")
  priceListItemsUpdated    PriceListItem[]     @relation("PriceListItemUpdatedBy")
  paymentMethodsCreated    PaymentMethod[]     @relation("PaymentMethodCreatedBy")
  paymentMethodsUpdated    PaymentMethod[]     @relation("PaymentMethodUpdatedBy")
  paymentTermsCreated      PaymentTerm[]       @relation("PaymentTermCreatedBy")
  paymentTermsUpdated      PaymentTerm[]       @relation("PaymentTermUpdatedBy")
  warehousesCreated        Warehouse[]         @relation("WarehouseCreatedBy")
  warehousesUpdated        Warehouse[]         @relation("WarehouseUpdatedBy")
  inventoryMovementsPosted InventoryMovement[] @relation("InventoryMovementPostedBy")
  transfersCreated         InventoryTransfer[] @relation("InventoryTransferCreatedBy")
  transfersCompleted       InventoryTransfer[] @relation("InventoryTransferCompletedBy")
  countsCreated            InventoryCount[]    @relation("InventoryCountCreatedBy")
  countsPosted             InventoryCount[]    @relation("InventoryCountPostedBy")

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id String @id @default(cuid())

  userId    String
  companyId String

  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roles MembershipRole[]

  @@unique([userId, companyId])
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  system      Boolean @default(true)

  memberships MembershipRole[]
}

model MembershipRole {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model Account {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Partner {
  id String @id @default(cuid())

  code   String        @default(cuid())
  type   PartnerType   @default(COMPANY)
  status PartnerStatus @default(ACTIVE)

  name        String
  displayName String?
  legalName   String?
  firstName   String?
  lastName    String?

  vatNumber String?
  taxCode   String?

  email String?
  pec   String?

  phone  String?
  mobile String?

  website String?

  address  String?
  zipCode  String?
  city     String?
  province String?
  country  String?

  isCustomer Boolean @default(false)
  isSupplier Boolean @default(false)
  isLead     Boolean @default(false)
  isProspect Boolean @default(false)

  isCollaborator Boolean @default(false)
  isAgent        Boolean @default(false)
  isCarrier      Boolean @default(false)
  isProfessional Boolean @default(false)

  category        String?
  priceListId     String?
  paymentMethodId String?
  paymentTermId   String?
  creditLimit     Decimal? @db.Decimal(15, 2)
  discountPercent Decimal? @db.Decimal(5, 2)

  recipientCode String?
  splitPayment  Boolean @default(false)
  reverseCharge Boolean @default(false)

  internalNotes String?

  active    Boolean   @default(true)
  deletedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  agentId         String?
  agent           Partner?       @relation("PartnerAgent", fields: [agentId], references: [id], onDelete: SetNull)
  managedPartners Partner[]      @relation("PartnerAgent")
  priceList       PriceList?     @relation(fields: [companyId, priceListId], references: [companyId, id], onDelete: Restrict)
  paymentMethod   PaymentMethod? @relation(fields: [companyId, paymentMethodId], references: [companyId, id], onDelete: Restrict)
  paymentTerm     PaymentTerm?   @relation(fields: [companyId, paymentTermId], references: [companyId, id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("PartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, active, deletedAt])
  @@index([companyId, type])
  @@index([companyId, category])
  @@index([companyId, name])
  @@index([companyId, vatNumber])
  @@index([companyId, taxCode])
  @@index([agentId])
  @@index([companyId, priceListId])
  @@index([companyId, paymentMethodId])
  @@index([companyId, paymentTermId])
}

model ItemCategory {
  id String @id @default(cuid())

  companyId   String
  code        String
  name        String
  description String?
  parentId    String?
  active      Boolean   @default(true)
  deletedAt   DateTime?

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      ItemCategory?  @relation("ItemCategoryTree", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children    ItemCategory[] @relation("ItemCategoryTree")
  items       Item[]
  createdById String?
  createdBy   User?          @relation("ItemCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?          @relation("ItemCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
  @@index([companyId, parentId])
}

model UnitOfMeasure {
  id String @id @default(cuid())

  companyId   String
  code        String
  name        String
  description String?
  symbol      String
  precision   Int       @default(2)
  active      Boolean   @default(true)
  deletedAt   DateTime?

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items                  Item[]
  recipeComponents       RecipeComponent[]
  packageComponents      PackageComponent[]
  inventoryMovements     InventoryMovement[]
  inventoryTransferLines InventoryTransferLine[]
  inventoryCountLines    InventoryCountLine[]
  createdById            String?
  createdBy              User?                   @relation("UnitOfMeasureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?
  updatedBy              User?                   @relation("UnitOfMeasureUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model VatRate {
  id String @id @default(cuid())

  companyId   String
  code        String
  name        String
  description String?
  percentage  Decimal   @db.Decimal(5, 2)
  natureCode  String?
  active      Boolean   @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  deletedAt   DateTime?

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       Item[]
  createdById String?
  createdBy   User?   @relation("VatRateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("VatRateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model PriceList {
  id          String          @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?
  currency    String          @default("EUR")
  active      Boolean         @default(true)
  deletedAt   DateTime?
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       PriceListItem[]
  partners    Partner[]
  createdById String?
  createdBy   User?           @relation("PriceListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?           @relation("PriceListUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model PriceListItem {
  id          String    @id @default(cuid())
  companyId   String
  priceListId String
  itemId      String
  price       Decimal   @db.Decimal(15, 2)
  active      Boolean   @default(true)
  deletedAt   DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList   PriceList @relation(fields: [companyId, priceListId], references: [companyId, id], onDelete: Cascade)
  item        Item      @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("PriceListItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("PriceListItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, priceListId, itemId])
  @@index([companyId, itemId, deletedAt])
  @@index([companyId, priceListId, deletedAt])
}

model PaymentMethod {
  id          String    @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?
  active      Boolean   @default(true)
  deletedAt   DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partners    Partner[]
  createdById String?
  createdBy   User?     @relation("PaymentMethodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("PaymentMethodUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model PaymentTerm {
  id           String    @id @default(cuid())
  companyId    String
  code         String
  name         String
  description  String?
  dueDays      Int?
  endOfMonth   Boolean   @default(false)
  installments Json?
  active       Boolean   @default(true)
  deletedAt    DateTime?
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partners     Partner[]
  createdById  String?
  createdBy    User?     @relation("PaymentTermCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById  String?
  updatedBy    User?     @relation("PaymentTermUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model Item {
  id String @id @default(cuid())

  companyId String
  code      String     @default(cuid())
  type      ItemType
  status    ItemStatus @default(ACTIVE)
  active    Boolean    @default(true)

  name          String
  shortName     String?
  description   String?
  internalNotes String?
  barcode       String?
  sku           String?
  imageUrl      String?

  categoryId      String?
  unitOfMeasureId String?
  vatRateId       String?

  salePrice     Decimal? @db.Decimal(15, 2)
  purchasePrice Decimal? @db.Decimal(15, 2)
  standardCost  Decimal? @db.Decimal(15, 2)
  currency      String   @default("EUR")

  sellable        Boolean @default(true)
  purchasable     Boolean @default(false)
  stockManaged    Boolean @default(false)
  trackLots       Boolean @default(false)
  trackSerials    Boolean @default(false)
  trackExpiration Boolean @default(false)

  createdById String?
  updatedById String?
  deletedAt   DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      ItemCategory?  @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)
  unitOfMeasure UnitOfMeasure? @relation(fields: [companyId, unitOfMeasureId], references: [companyId, id], onDelete: Restrict)
  vatRate       VatRate?       @relation(fields: [companyId, vatRateId], references: [companyId, id], onDelete: Restrict)
  createdBy     User?          @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("ItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  productProfile         ProductProfile?
  serviceProfile         ServiceProfile?
  ingredientProfile      IngredientProfile?
  recipeProfile          RecipeProfile?
  beautyServiceProfile   BeautyServiceProfile?
  hotelRoomProfile       HotelRoomProfile?
  packageProfile         PackageProfile?
  giftCardProfile        GiftCardProfile?
  recipeComponents       RecipeComponent[]       @relation("RecipeOwner")
  usedInRecipes          RecipeComponent[]       @relation("RecipeComponentItem")
  packageComponents      PackageComponent[]      @relation("PackageOwner")
  usedInPackages         PackageComponent[]      @relation("PackageComponentItem")
  priceLists             PriceListItem[]
  inventoryLots          InventoryLot[]
  inventorySerials       InventorySerial[]
  inventoryMovements     InventoryMovement[]
  inventoryTransferLines InventoryTransferLine[]
  inventoryCountLines    InventoryCountLine[]
  stockBalances          StockBalance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
  @@index([companyId, type])
  @@index([companyId, categoryId])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([companyId, barcode])
}

model ProductProfile {
  itemId    String @id
  companyId String

  weight       Decimal? @db.Decimal(15, 3)
  dimensions   Json?
  manufacturer String?
  brand        String?
  reorderPoint Decimal? @db.Decimal(15, 3)
  minimumStock Decimal? @db.Decimal(15, 3)

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model ServiceProfile {
  itemId    String @id
  companyId String

  durationMinutes     Int?
  requiresAppointment Boolean @default(false)
  defaultCapacity     Int?

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model IngredientProfile {
  itemId    String @id
  companyId String

  yieldPercentage     Decimal? @db.Decimal(5, 2)
  storageInstructions String?
  allergenNotes       String?
  perishabilityDays   Int?

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model RecipeProfile {
  itemId    String @id
  companyId String

  preparationMinutes Int?
  portions           Decimal? @db.Decimal(15, 3)
  yieldQuantity      Decimal? @db.Decimal(15, 3)
  instructions       String?
  foodCostTarget     Decimal? @db.Decimal(5, 2)

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model RecipeComponent {
  id String @id @default(cuid())

  companyId       String
  recipeItemId    String
  componentItemId String
  unitOfMeasureId String
  quantity        Decimal   @db.Decimal(15, 3)
  wastePercentage Decimal?  @db.Decimal(5, 2)
  sortOrder       Int       @default(0)
  deletedAt       DateTime?

  recipeItem    Item          @relation("RecipeOwner", fields: [companyId, recipeItemId], references: [companyId, id], onDelete: Cascade)
  componentItem Item          @relation("RecipeComponentItem", fields: [companyId, componentItemId], references: [companyId, id], onDelete: Restrict)
  unitOfMeasure UnitOfMeasure @relation(fields: [companyId, unitOfMeasureId], references: [companyId, id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, recipeItemId, componentItemId])
  @@index([companyId, recipeItemId, deletedAt])
  @@index([companyId, componentItemId])
}

model BeautyServiceProfile {
  itemId    String @id
  companyId String

  durationMinutes       Int
  cleanupMinutes        Int?
  requiresCabin         Boolean @default(false)
  requiresOperator      Boolean @default(true)
  recommendedRepeatDays Int?
  consentRequired       Boolean @default(false)

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model HotelRoomProfile {
  itemId    String @id
  companyId String

  capacityAdults       Int     @default(1)
  capacityChildren     Int     @default(0)
  roomTypeCode         String?
  physicalRoomCode     String?
  floor                String?
  sellableUnit         Boolean @default(true)
  housekeepingRequired Boolean @default(true)

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model PackageProfile {
  itemId    String @id
  companyId String

  validityDays Int?
  usageLimit   Int?

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model PackageComponent {
  id String @id @default(cuid())

  companyId       String
  packageItemId   String
  componentItemId String
  unitOfMeasureId String
  quantity        Decimal   @db.Decimal(15, 3)
  sortOrder       Int       @default(0)
  deletedAt       DateTime?

  packageItem   Item          @relation("PackageOwner", fields: [companyId, packageItemId], references: [companyId, id], onDelete: Cascade)
  componentItem Item          @relation("PackageComponentItem", fields: [companyId, componentItemId], references: [companyId, id], onDelete: Restrict)
  unitOfMeasure UnitOfMeasure @relation(fields: [companyId, unitOfMeasureId], references: [companyId, id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, packageItemId, componentItemId])
  @@index([companyId, packageItemId, deletedAt])
  @@index([companyId, componentItemId])
}

model GiftCardProfile {
  itemId    String @id
  companyId String

  defaultValidityDays Int
  fixedValue          Decimal? @db.Decimal(15, 2)
  reusable            Boolean  @default(false)
  transferable        Boolean  @default(true)

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model Location {
  id         String      @id @default(cuid())
  companyId  String
  code       String
  name       String
  address    String?
  city       String?
  active     Boolean     @default(true)
  deletedAt  DateTime?
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model Warehouse {
  id                   String              @id @default(cuid())
  companyId            String
  locationId           String
  code                 String
  name                 String
  description          String?
  active               Boolean             @default(true)
  allowNegativeStock   Boolean             @default(false)
  deletedAt            DateTime?
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location             Location            @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  bins                 WarehouseBin[]
  movements            InventoryMovement[]
  sourceTransfers      InventoryTransfer[] @relation("TransferSourceWarehouse")
  destinationTransfers InventoryTransfer[] @relation("TransferDestinationWarehouse")
  counts               InventoryCount[]
  balances             StockBalance[]
  createdById          String?
  createdBy            User?               @relation("WarehouseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?               @relation("WarehouseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, locationId, active, deletedAt])
}

model WarehouseBin {
  id                   String              @id @default(cuid())
  companyId            String
  warehouseId          String
  code                 String
  name                 String
  description          String?
  binType              String?
  active               Boolean             @default(true)
  deletedAt            DateTime?
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse            Warehouse           @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Cascade)
  movements            InventoryMovement[]
  sourceTransfers      InventoryTransfer[] @relation("TransferSourceBin")
  destinationTransfers InventoryTransfer[] @relation("TransferDestinationBin")
  counts               InventoryCount[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([companyId, warehouseId, code])
  @@unique([companyId, id])
  @@index([companyId, warehouseId, active, deletedAt])
}

model InventoryLot {
  id              String                  @id @default(cuid())
  companyId       String
  itemId          String
  lotNumber       String
  manufactureDate DateTime?
  expirationDate  DateTime?
  supplierLot     String?
  active          Boolean                 @default(true)
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item            Item                    @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  movements       InventoryMovement[]
  transferLines   InventoryTransferLine[]
  countLines      InventoryCountLine[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([companyId, itemId, lotNumber])
  @@unique([companyId, id])
  @@index([companyId, expirationDate, active])
}

model InventorySerial {
  id            String                  @id @default(cuid())
  companyId     String
  itemId        String
  serialNumber  String
  status        InventorySerialStatus   @default(AVAILABLE)
  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item          Item                    @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  movements     InventoryMovement[]
  transferLines InventoryTransferLine[]
  countLines    InventoryCountLine[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([companyId, serialNumber])
  @@unique([companyId, id])
  @@index([companyId, itemId, status])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  companyId       String
  warehouseId     String
  binId           String?
  itemId          String
  movementType    InventoryMovementType
  quantity        Decimal               @db.Decimal(15, 3)
  direction       Int
  unitOfMeasureId String
  lotId           String?
  serialId        String?
  unitCost        Decimal?              @db.Decimal(15, 4)
  totalCost       Decimal?              @db.Decimal(15, 2)
  referenceType   String?
  referenceId     String?
  reason          String?
  note            String?
  occurredAt      DateTime
  postedAt        DateTime
  postedById      String
  reversalOfId    String?               @unique
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse       Warehouse             @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  bin             WarehouseBin?         @relation(fields: [companyId, binId], references: [companyId, id], onDelete: Restrict)
  item            Item                  @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  unitOfMeasure   UnitOfMeasure         @relation(fields: [companyId, unitOfMeasureId], references: [companyId, id], onDelete: Restrict)
  lot             InventoryLot?         @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  serial          InventorySerial?      @relation(fields: [companyId, serialId], references: [companyId, id], onDelete: Restrict)
  postedBy        User                  @relation("InventoryMovementPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  reversalOf      InventoryMovement?    @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy      InventoryMovement?    @relation("MovementReversal")
  createdAt       DateTime              @default(now())

  @@unique([companyId, id])
  @@index([companyId, warehouseId, itemId, postedAt])
  @@index([companyId, lotId, postedAt])
  @@index([companyId, serialId, postedAt])
  @@index([companyId, referenceType, referenceId])
}

model InventoryTransfer {
  id                     String                  @id @default(cuid())
  companyId              String
  code                   String
  sourceWarehouseId      String
  destinationWarehouseId String
  sourceBinId            String?
  destinationBinId       String?
  status                 InventoryTransferStatus @default(DRAFT)
  requestedAt            DateTime                @default(now())
  completedAt            DateTime?
  createdById            String
  completedById          String?
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceWarehouse        Warehouse               @relation("TransferSourceWarehouse", fields: [companyId, sourceWarehouseId], references: [companyId, id], onDelete: Restrict)
  destinationWarehouse   Warehouse               @relation("TransferDestinationWarehouse", fields: [companyId, destinationWarehouseId], references: [companyId, id], onDelete: Restrict)
  sourceBin              WarehouseBin?           @relation("TransferSourceBin", fields: [companyId, sourceBinId], references: [companyId, id], onDelete: Restrict)
  destinationBin         WarehouseBin?           @relation("TransferDestinationBin", fields: [companyId, destinationBinId], references: [companyId, id], onDelete: Restrict)
  lines                  InventoryTransferLine[]
  createdBy              User                    @relation("InventoryTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy            User?                   @relation("InventoryTransferCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, status, requestedAt])
}

model InventoryTransferLine {
  id              String            @id @default(cuid())
  companyId       String
  transferId      String
  itemId          String
  quantity        Decimal           @db.Decimal(15, 3)
  unitOfMeasureId String
  lotId           String?
  serialId        String?
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transfer        InventoryTransfer @relation(fields: [companyId, transferId], references: [companyId, id], onDelete: Cascade)
  item            Item              @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  unitOfMeasure   UnitOfMeasure     @relation(fields: [companyId, unitOfMeasureId], references: [companyId, id], onDelete: Restrict)
  lot             InventoryLot?     @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  serial          InventorySerial?  @relation(fields: [companyId, serialId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, transferId])
}

model InventoryCount {
  id          String               @id @default(cuid())
  companyId   String
  warehouseId String
  binId       String?
  code        String
  status      InventoryCountStatus @default(DRAFT)
  countedAt   DateTime?
  postedAt    DateTime?
  createdById String
  postedById  String?
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse   Warehouse            @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  bin         WarehouseBin?        @relation(fields: [companyId, binId], references: [companyId, id], onDelete: Restrict)
  lines       InventoryCountLine[]
  createdBy   User                 @relation("InventoryCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy    User?                @relation("InventoryCountPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, status, createdAt])
}

model InventoryCountLine {
  id               String           @id @default(cuid())
  companyId        String
  inventoryCountId String
  itemId           String
  lotId            String?
  serialId         String?
  expectedQuantity Decimal          @db.Decimal(15, 3)
  countedQuantity  Decimal          @db.Decimal(15, 3)
  difference       Decimal          @db.Decimal(15, 3)
  unitOfMeasureId  String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryCount   InventoryCount   @relation(fields: [companyId, inventoryCountId], references: [companyId, id], onDelete: Cascade)
  item             Item             @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  unitOfMeasure    UnitOfMeasure    @relation(fields: [companyId, unitOfMeasureId], references: [companyId, id], onDelete: Restrict)
  lot              InventoryLot?    @relation(fields: [companyId, lotId], references: [companyId, id], onDelete: Restrict)
  serial           InventorySerial? @relation(fields: [companyId, serialId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, inventoryCountId])
}

model StockBalance {
  id          String    @id @default(cuid())
  companyId   String
  warehouseId String
  itemId      String
  quantity    Decimal   @default(0) @db.Decimal(15, 3)
  averageCost Decimal   @default(0) @db.Decimal(15, 4)
  stockValue  Decimal   @default(0) @db.Decimal(15, 2)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Cascade)
  item        Item      @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, warehouseId, itemId])
  @@index([companyId, itemId])
}

model DomainEvent {
  id            String    @id @default(cuid())
  companyId     String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, eventType, processedAt, occurredAt])
  @@index([aggregateType, aggregateId])
}
