generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PartnerType {
  COMPANY
  PERSON
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum ItemType {
  PRODUCT
  SERVICE
  INGREDIENT
  RECIPE
  BEAUTY_SERVICE
  HOTEL_ROOM
  PACKAGE
  GIFT_CARD
}

enum ItemStatus {
  ACTIVE
  SUSPENDED
}

enum ModuleCategory {
  CORE
  SHARED
  RESTAURANT
  BEAUTY
  HOTEL
}

enum ModuleStatus {
  AVAILABLE
  PLANNED
  FUTURE
}

enum InventoryMovementType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  INVENTORY_GAIN
  INVENTORY_LOSS
  CONSUMPTION
  PRODUCTION
  RETURN_IN
  RETURN_OUT
  REVERSAL
}

enum InventorySerialStatus {
  AVAILABLE
  RESERVED
  ISSUED
  BLOCKED
}

enum InventoryTransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InventoryCountStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DocumentType {
  QUOTE
  SALES_ORDER
  PURCHASE_ORDER
  GOODS_RECEIPT
  DELIVERY_NOTE
  SALES_INVOICE
  SALES_RECEIPT
  PURCHASE_INVOICE
  INVENTORY_DOCUMENT
  RETURN
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  POSTED
  CANCELLED
  CLOSED
}

enum DocumentLinkType {
  QUOTE_TO_ORDER
  ORDER_TO_DDT
  DDT_TO_INVOICE
  ORDER_TO_INVOICE
  RETURN_TO_CREDIT_NOTE
  PURCHASE_ORDER_TO_RECEIPT
  RECEIPT_TO_PURCHASE_INVOICE
  PURCHASE_ORDER_TO_PURCHASE_INVOICE
  RECEIPT_TO_PURCHASE_RETURN
  PURCHASE_RETURN_TO_CREDIT_NOTE
}

enum FinancialAccountType {
  BANK
  CASH
  CARD
  PAYPAL
  OTHER
}

enum PaymentScheduleDirection {
  RECEIVABLE
  PAYABLE
}

enum PaymentScheduleStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

enum FinancialMovementType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  TRANSFER_OUT
  TRANSFER_IN
  FEE
  INTEREST
  REFUND_IN
  REFUND_OUT
  OPENING
  ADJUSTMENT
  REVERSAL
}

enum FinancialMovementDirection {
  IN
  OUT
}

enum FinancialTransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum BankStatementStatus {
  IMPORTED
  PARTIALLY_RECONCILED
  RECONCILED
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
}

enum RestaurantTableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  OUT_OF_SERVICE
}

enum RestaurantReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
  WAITLIST
}

enum RestaurantReservationSource {
  PHONE
  WALK_IN
  WEBSITE
  MANUAL
  THIRD_PARTY
}

enum RestaurantOrderStatus {
  OPEN
  SENT
  IN_PROGRESS
  READY
  SERVED
  CLOSED
  CANCELLED
}

enum RestaurantServiceType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  EVENT
}

enum RestaurantPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum RestaurantOrderLineStatus {
  NEW
  SENT
  IN_PREPARATION
  READY
  SERVED
  CANCELLED
}

enum KitchenTicketStatus {
  NEW
  IN_PREPARATION
  READY
  COMPLETED
  CANCELLED
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  vatNumber String? @unique
  taxCode   String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  currency  String  @default("EUR")
  timezone  String  @default("Europe/Rome")
  locale    String  @default("it-IT")
  active    Boolean @default(true)
  logo      String?

  memberships                  Membership[]
  partners                     Partner[]
  modules                      CompanyModule[]
  items                        Item[]
  itemCategories               ItemCategory[]
  unitsOfMeasure               UnitOfMeasure[]
  vatRates                     VatRate[]
  priceLists                   PriceList[]
  priceListItems               PriceListItem[]
  paymentMethods               PaymentMethod[]
  paymentTerms                 PaymentTerm[]
  locations                    Location[]
  warehouses                   Warehouse[]
  warehouseBins                WarehouseBin[]
  inventoryLots                InventoryLot[]
  inventorySerials             InventorySerial[]
  inventoryMovements           InventoryMovement[]
  inventoryTransfers           InventoryTransfer[]
  inventoryTransferLines       InventoryTransferLine[]
  inventoryCounts              InventoryCount[]
  inventoryCountLines          InventoryCountLine[]
  stockBalances                StockBalance[]
  domainEvents                 DomainEvent[]
  documentSeries               DocumentSeries[]
  businessDocuments            BusinessDocument[]
  businessDocumentLines        BusinessDocumentLine[]
  documentAttachments          DocumentAttachment[]
  documentEvents               DocumentEvent[]
  documentLinks                DocumentLink[]
  financialAccounts            FinancialAccount[]
  paymentSchedules             PaymentSchedule[]
  financialMovements           FinancialMovement[]
  financialAllocations         FinancialAllocation[]
  financialTransfers           FinancialTransfer[]
  bankStatements               BankStatement[]
  bankStatementLines           BankStatementLine[]
  restaurantAreas              RestaurantArea[]
  restaurantTables             RestaurantTable[]
  restaurantReservations       RestaurantReservation[]
  restaurantReservationTables  RestaurantReservationTable[]
  restaurantMenus              RestaurantMenu[]
  restaurantMenuSections       RestaurantMenuSection[]
  restaurantMenuItems          RestaurantMenuItem[]
  restaurantOrders             RestaurantOrder[]
  restaurantOrderLines         RestaurantOrderLine[]
  restaurantOrderLineModifiers RestaurantOrderLineModifier[]
  kitchenStations              KitchenStation[]
  kitchenStationAssignments    KitchenStationAssignment[]
  kitchenTickets               KitchenTicket[]
  kitchenTicketLines           KitchenTicketLine[]
  recipeConsumptions           RecipeConsumption[]
  idempotencyRecords           IdempotencyRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModuleDefinition {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  category    ModuleCategory
  mandatory   Boolean        @default(false)
  status      ModuleStatus

  companies CompanyModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyModule {
  id String @id @default(cuid())

  companyId          String
  moduleDefinitionId String
  enabled            Boolean   @default(false)
  enabledAt          DateTime?
  disabledAt         DateTime?
  configuration      Json?

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  moduleDefinition ModuleDefinition @relation(fields: [moduleDefinitionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleDefinitionId])
  @@index([companyId, enabled])
  @@index([moduleDefinitionId])
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  active Boolean @default(true)

  emailVerified DateTime?
  image         String?
  lastLogin     DateTime?

  locale   String @default("it-IT")
  timeZone String @default("Europe/Rome")

  memberships                 Membership[]
  partnersCreated             Partner[]           @relation("PartnerCreatedBy")
  partnersUpdated             Partner[]           @relation("PartnerUpdatedBy")
  itemsCreated                Item[]              @relation("ItemCreatedBy")
  itemsUpdated                Item[]              @relation("ItemUpdatedBy")
  itemCategoriesCreated       ItemCategory[]      @relation("ItemCategoryCreatedBy")
  itemCategoriesUpdated       ItemCategory[]      @relation("ItemCategoryUpdatedBy")
  unitsCreated                UnitOfMeasure[]     @relation("UnitOfMeasureCreatedBy")
  unitsUpdated                UnitOfMeasure[]     @relation("UnitOfMeasureUpdatedBy")
  vatRatesCreated             VatRate[]           @relation("VatRateCreatedBy")
  vatRatesUpdated             VatRate[]           @relation("VatRateUpdatedBy")
  priceListsCreated           PriceList[]         @relation("PriceListCreatedBy")
  priceListsUpdated           PriceList[]         @relation("PriceListUpdatedBy")
  priceListItemsCreated       PriceListItem[]     @relation("PriceListItemCreatedBy")
  priceListItemsUpdated       PriceListItem[]     @relation("PriceListItemUpdatedBy")
  paymentMethodsCreated       PaymentMethod[]     @relation("PaymentMethodCreatedBy")
  paymentMethodsUpdated       PaymentMethod[]     @relation("PaymentMethodUpdatedBy")
  paymentTermsCreated         PaymentTerm[]       @relation("PaymentTermCreatedBy")
  paymentTermsUpdated         PaymentTerm[]       @relation("PaymentTermUpdatedBy")
  warehousesCreated           Warehouse[]         @relation("WarehouseCreatedBy")
  warehousesUpdated           Warehouse[]         @relation("WarehouseUpdatedBy")
  inventoryMovementsPosted    InventoryMovement[] @relation("InventoryMovementPostedBy")
  transfersCreated            InventoryTransfer[] @relation("InventoryTransferCreatedBy")
  transfersCompleted          InventoryTransfer[] @relation("InventoryTransferCompletedBy")
  countsCreated               InventoryCount[]    @relation("InventoryCountCreatedBy")
  countsPosted                InventoryCount[]    @relation("InventoryCountPostedBy")
  documentsCreated            BusinessDocument[]  @relation("BusinessDocumentCreatedBy")
  documentsUpdated            BusinessDocument[]  @relation("BusinessDocumentUpdatedBy")
  documentEventsCreated       DocumentEvent[]     @relation("DocumentEventCreatedBy")
  documentLinksCreated        DocumentLink[]      @relation("DocumentLinkCreatedBy")
  financialAccountsCreated    FinancialAccount[]  @relation("FinancialAccountCreatedBy")
  financialAccountsUpdated    FinancialAccount[]  @relation("FinancialAccountUpdatedBy")
  paymentSchedulesCreated     PaymentSchedule[]   @relation("PaymentScheduleCreatedBy")
  paymentSchedulesUpdated     PaymentSchedule[]   @relation("PaymentScheduleUpdatedBy")
  financialMovementsPosted    FinancialMovement[] @relation("FinancialMovementPostedBy")
  financialTransfersCreated   FinancialTransfer[] @relation("FinancialTransferCreatedBy")
  financialTransfersCompleted FinancialTransfer[] @relation("FinancialTransferCompletedBy")

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id String @id @default(cuid())

  userId    String
  companyId String

  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roles MembershipRole[]

  @@unique([userId, companyId])
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  system      Boolean @default(true)

  memberships MembershipRole[]
}

model MembershipRole {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model Account {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Partner {
  id String @id @default(cuid())

  code   String        @default(cuid())
  type   PartnerType   @default(COMPANY)
  status PartnerStatus @default(ACTIVE)

  name        String
  displayName String?
  legalName   String?
  firstName   String?
  lastName    String?

  vatNumber String?
  taxCode   String?

  email String?
  pec   String?

  phone  String?
  mobile String?

  website String?

  address  String?
  zipCode  String?
  city     String?
  province String?
  country  String?

  isCustomer Boolean @default(false)
  isSupplier Boolean @default(false)
  isLead     Boolean @default(false)
  isProspect Boolean @default(false)

  isCollaborator Boolean @default(false)
  isAgent        Boolean @default(false)
  isCarrier      Boolean @default(false)
  isProfessional Boolean @default(false)

  category        String?
  priceListId     String?
  paymentMethodId String?
  paymentTermId   String?
  creditLimit     Decimal? @db.Decimal(15, 2)
  discountPercent Decimal? @db.Decimal(5, 2)

  recipientCode String?
  splitPayment  Boolean @default(false)
  reverseCharge Boolean @default(false)

  internalNotes String?

  active    Boolean   @default(true)
  deletedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  agentId                String?
  agent                  Partner?                @relation("PartnerAgent", fields: [agentId], references: [id], onDelete: SetNull)
  managedPartners        Partner[]               @relation("PartnerAgent")
  businessDocuments      BusinessDocument[]
  paymentSchedules       PaymentSchedule[]
  financialMovements     FinancialMovement[]
  restaurantReservations RestaurantReservation[]
  restaurantOrders       RestaurantOrder[]
  priceList              PriceList?              @relation(fields: [companyId, priceListId], references: [companyId, id], onDelete: Restrict)
  paymentMethod          PaymentMethod?          @relation(fields: [companyId, paymentMethodId], references: [companyId, id], onDelete: Restrict)
  paymentTerm            PaymentTerm?            @relation(fields: [companyId, paymentTermId], references: [companyId, id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("PartnerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
  @@index([companyId, type])
  @@index([companyId, category])
  @@index([companyId, name])
  @@index([companyId, vatNumber])
  @@index([companyId, taxCode])
  @@index([agentId])
  @@index([companyId, priceListId])
  @@index([companyId, paymentMethodId])
  @@index([companyId, paymentTermId])
}

model ItemCategory {
  id String @id @default(cuid())

  companyId   String
  code        String
  name        String
  description String?
  parentId    String?
  active      Boolean   @default(true)
  deletedAt   DateTime?

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent                ItemCategory?          @relation("ItemCategoryTree", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children              ItemCategory[]         @relation("ItemCategoryTree")
  items                 Item[]
  businessDocumentLines BusinessDocumentLine[]
  createdById           String?
  createdBy             User?                  @relation("ItemCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?
  updatedBy             User?                  @relation("ItemCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  kitchenStationAssignments KitchenStationAssignment[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
  @@index([companyId, parentId])
}

model UnitOfMeasure {
  id String @id @default(cuid())

  companyId   String
  code        String
  name        String
  description String?
  symbol      String
  precision   Int       @default(2)
  active      Boolean   @default(true)
  deletedAt   DateTime?

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items                  Item[]
  recipeComponents       RecipeComponent[]
  packageComponents      PackageComponent[]
  inventoryMovements     InventoryMovement[]
  inventoryTransferLines InventoryTransferLine[]
  inventoryCountLines    InventoryCountLine[]
  createdById            String?
  createdBy              User?                   @relation("UnitOfMeasureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?
  updatedBy              User?                   @relation("UnitOfMeasureUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  businessDocumentLines BusinessDocumentLine[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model VatRate {
  id String @id @default(cuid())

  companyId   String
  code        String
  name        String
  description String?
  percentage  Decimal   @db.Decimal(5, 2)
  natureCode  String?
  active      Boolean   @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  deletedAt   DateTime?

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       Item[]
  createdById String?
  createdBy   User?   @relation("VatRateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("VatRateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  businessDocumentLines BusinessDocumentLine[]
  restaurantOrderLines  RestaurantOrderLine[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model PriceList {
  id                String             @id @default(cuid())
  companyId         String
  code              String
  name              String
  description       String?
  currency          String             @default("EUR")
  active            Boolean            @default(true)
  deletedAt         DateTime?
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items             PriceListItem[]
  partners          Partner[]
  businessDocuments BusinessDocument[]
  createdById       String?
  createdBy         User?              @relation("PriceListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?              @relation("PriceListUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model PriceListItem {
  id          String    @id @default(cuid())
  companyId   String
  priceListId String
  itemId      String
  price       Decimal   @db.Decimal(15, 2)
  active      Boolean   @default(true)
  deletedAt   DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList   PriceList @relation(fields: [companyId, priceListId], references: [companyId, id], onDelete: Cascade)
  item        Item      @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("PriceListItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("PriceListItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, priceListId, itemId])
  @@index([companyId, itemId, deletedAt])
  @@index([companyId, priceListId, deletedAt])
}

model PaymentMethod {
  id                String             @id @default(cuid())
  companyId         String
  code              String
  name              String
  description       String?
  active            Boolean            @default(true)
  deletedAt         DateTime?
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partners          Partner[]
  businessDocuments BusinessDocument[]
  paymentSchedules  PaymentSchedule[]
  createdById       String?
  createdBy         User?              @relation("PaymentMethodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?              @relation("PaymentMethodUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model PaymentTerm {
  id                String             @id @default(cuid())
  companyId         String
  code              String
  name              String
  description       String?
  dueDays           Int?
  endOfMonth        Boolean            @default(false)
  installments      Json?
  active            Boolean            @default(true)
  deletedAt         DateTime?
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partners          Partner[]
  businessDocuments BusinessDocument[]
  paymentSchedules  PaymentSchedule[]
  createdById       String?
  createdBy         User?              @relation("PaymentTermCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?              @relation("PaymentTermUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
}

model Item {
  id String @id @default(cuid())

  companyId String
  code      String     @default(cuid())
  type      ItemType
  status    ItemStatus @default(ACTIVE)
  active    Boolean    @default(true)

  name          String
  shortName     String?
  description   String?
  internalNotes String?
  barcode       String?
  sku           String?
  imageUrl      String?

  categoryId      String?
  unitOfMeasureId String?
  vatRateId       String?

  salePrice     Decimal? @db.Decimal(15, 2)
  purchasePrice Decimal? @db.Decimal(15, 2)
  standardCost  Decimal? @db.Decimal(15, 2)
  currency      String   @default("EUR")

  sellable        Boolean @default(true)
  purchasable     Boolean @default(false)
  stockManaged    Boolean @default(false)
  trackLots       Boolean @default(false)
  trackSerials    Boolean @default(false)
  trackExpiration Boolean @default(false)

  createdById String?
  updatedById String?
  deletedAt   DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      ItemCategory?  @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)
  unitOfMeasure UnitOfMeasure? @relation(fields: [companyId, unitOfMeasureId], references: [companyId, id], onDelete: Restrict)
  vatRate       VatRate?       @relation(fields: [companyId, vatRateId], references: [companyId, id], onDelete: Restrict)
  createdBy     User?          @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("ItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  productProfile               ProductProfile?
  serviceProfile               ServiceProfile?
  ingredientProfile            IngredientProfile?
  recipeProfile                RecipeProfile?
  beautyServiceProfile         BeautyServiceProfile?
  hotelRoomProfile             HotelRoomProfile?
  packageProfile               PackageProfile?
  giftCardProfile              GiftCardProfile?
  recipeComponents             RecipeComponent[]             @relation("RecipeOwner")
  usedInRecipes                RecipeComponent[]             @relation("RecipeComponentItem")
  packageComponents            PackageComponent[]            @relation("PackageOwner")
  usedInPackages               PackageComponent[]            @relation("PackageComponentItem")
  priceLists                   PriceListItem[]
  inventoryLots                InventoryLot[]
  inventorySerials             InventorySerial[]
  inventoryMovements           InventoryMovement[]
  inventoryTransferLines       InventoryTransferLine[]
  inventoryCountLines          InventoryCountLine[]
  stockBalances                StockBalance[]
  businessDocumentLines        BusinessDocumentLine[]
  restaurantMenuItems          RestaurantMenuItem[]
  restaurantOrderLines         RestaurantOrderLine[]
  restaurantOrderLineModifiers RestaurantOrderLineModifier[]
  kitchenAssignments           KitchenStationAssignment[]
  recipeConsumptionRecipes     RecipeConsumption[]           @relation("RecipeConsumptionRecipe")
  recipeConsumptionComponents  RecipeConsumption[]           @relation("RecipeConsumptionComponent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active, deletedAt])
  @@index([companyId, type])
  @@index([companyId, categoryId])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([companyId, barcode])
}

model ProductProfile {
  itemId    String @id
  companyId String

  weight       Decimal? @db.Decimal(15, 3)
  dimensions   Json?
  manufacturer String?
  brand        String?
  reorderPoint Decimal? @db.Decimal(15, 3)
  minimumStock Decimal? @db.Decimal(15, 3)

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
  @@index([companyId])
}

model ServiceProfile {
  itemId    String @id
  companyId String

  durationMinutes     Int?
  requiresAppointment Boolean @default(false)
  defaultCapacity     Int?

  item Item @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, itemId])
