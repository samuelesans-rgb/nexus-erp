  description       String?
  source            String?
  estimatedValue    Decimal   @default(0) @db.Decimal(15, 2)
  currency          String    @default("EUR")
  probability       Int
  expectedCloseDate DateTime?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  archivedAt        DateTime?

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner    Partner       @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict)
  pipeline   CrmPipeline   @relation(fields: [companyId, pipelineId], references: [companyId, id], onDelete: Restrict)
  stage      CrmStage      @relation(fields: [companyId, pipelineId, stageId], references: [companyId, pipelineId, id], onDelete: Restrict)
  owner      Membership    @relation("CrmOpportunityOwner", fields: [companyId, ownerMembershipId], references: [companyId, id], onDelete: Restrict)
  location   Location?     @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  activities CrmActivity[]
  events     CrmEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, id])
  @@index([companyId, ownerMembershipId, archivedAt])
  @@index([companyId, pipelineId, stageId, archivedAt])
  @@index([companyId, partnerId, archivedAt])
  @@index([companyId, locationId, archivedAt])
  @@index([companyId, expectedCloseDate])
}

model CrmActivity {
  id                    String              @id @default(cuid())
  companyId             String
  partnerId             String?
  opportunityId         String?
  assignedMembershipId  String
  createdByMembershipId String
  locationId            String?
  type                  CrmActivityType
  subject               String
  description           String?
  dueAt                 DateTime?
  priority              CrmActivityPriority @default(NORMAL)
  status                CrmActivityStatus   @default(OPEN)
  completedAt           DateTime?

  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner             Partner?        @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict)
  opportunity         CrmOpportunity? @relation(fields: [companyId, opportunityId], references: [companyId, id], onDelete: Cascade)
  assignedMembership  Membership      @relation("CrmActivityAssignee", fields: [companyId, assignedMembershipId], references: [companyId, id], onDelete: Restrict)
  createdByMembership Membership      @relation("CrmActivityCreator", fields: [companyId, createdByMembershipId], references: [companyId, id], onDelete: Restrict)
  location            Location?       @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  events              CrmEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, id])
  @@index([companyId, assignedMembershipId, status, dueAt])
  @@index([companyId, opportunityId, createdAt])
  @@index([companyId, partnerId, createdAt])
  @@index([companyId, locationId, status, dueAt])
}

model CrmEvent {
  id                String   @id @default(cuid())
  companyId         String
  opportunityId     String?
  activityId        String?
  actorMembershipId String
  eventType         String
  payload           Json?
  occurredAt        DateTime @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity     CrmOpportunity? @relation(fields: [companyId, opportunityId], references: [companyId, id], onDelete: Cascade)
  activity        CrmActivity?    @relation(fields: [companyId, activityId], references: [companyId, id], onDelete: Cascade)
  actorMembership Membership      @relation("CrmEventActor", fields: [companyId, actorMembershipId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, opportunityId, occurredAt])
  @@index([companyId, activityId, occurredAt])
}
