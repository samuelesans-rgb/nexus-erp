  installmentNumber            Int                      @default(1)
  documentType                 DocumentType?
  direction                    PaymentScheduleDirection
  dueDate                      DateTime
  amount                       Decimal                  @db.Decimal(15, 2)
  residualAmount               Decimal                  @db.Decimal(15, 2)
  currency                     String                   @default("EUR")
  status                       PaymentScheduleStatus    @default(OPEN)
  paymentMethodId              String?
  paymentTermId                String?
  notes                        String?
  createdById                  String
  updatedById                  String
  deletedAt                    DateTime?
  company                      Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  partner                      Partner                  @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict)
  document                     BusinessDocument?        @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  paymentMethod                PaymentMethod?           @relation(fields: [companyId, paymentMethodId], references: [companyId, id], onDelete: Restrict)
  paymentTerm                  PaymentTerm?             @relation(fields: [companyId, paymentTermId], references: [companyId, id], onDelete: Restrict)
  createdBy                    User                     @relation("PaymentScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                    User                     @relation("PaymentScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  movements                    FinancialMovement[]
  allocations                  FinancialAllocation[]
  restaurantReservationDeposit RestaurantReservation?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@unique([companyId, documentId, installmentNumber])
  @@unique([companyId, id])
  @@index([companyId, direction, status, dueDate])
  @@index([companyId, partnerId, dueDate])
}

model FinancialMovement {
  id                    String                     @id @default(cuid())
  companyId             String
  financialAccountId    String
  partnerId             String?
  paymentScheduleId     String?
  documentId            String?
  movementType          FinancialMovementType
  direction             FinancialMovementDirection
  amount                Decimal                    @db.Decimal(15, 2)
  currency              String                     @default("EUR")
  exchangeRate          Decimal                    @default(1) @db.Decimal(18, 6)
  occurredAt            DateTime
  valueDate             DateTime?
  reference             String?
  notes                 String?
  postedAt              DateTime                   @default(now())
  postedById            String
  reversalOfId          String?
  company               Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialAccount      FinancialAccount           @relation(fields: [companyId, financialAccountId], references: [companyId, id], onDelete: Restrict)
  partner               Partner?                   @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict)
  paymentSchedule       PaymentSchedule?           @relation(fields: [companyId, paymentScheduleId], references: [companyId, id], onDelete: Restrict)
  document              BusinessDocument?          @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  postedBy              User                       @relation("FinancialMovementPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  reversalOf            FinancialMovement?         @relation("FinancialMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals             FinancialMovement[]        @relation("FinancialMovementReversal")
  allocations           FinancialAllocation[]
  matchedStatementLines BankStatementLine[]
  createdAt             DateTime                   @default(now())

  @@unique([companyId, id])
  @@unique([reversalOfId])
  @@index([companyId, financialAccountId, occurredAt])
  @@index([companyId, partnerId, occurredAt])
  @@index([companyId, paymentScheduleId])
}

model FinancialAllocation {
  id         String            @id @default(cuid())
  companyId  String
  movementId String
  scheduleId String
  amount     Decimal           @db.Decimal(15, 2)
  reversedAt DateTime?
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  movement   FinancialMovement @relation(fields: [companyId, movementId], references: [companyId, id], onDelete: Restrict)
  schedule   PaymentSchedule   @relation(fields: [companyId, scheduleId], references: [companyId, id], onDelete: Restrict)
  createdAt  DateTime          @default(now())

  @@unique([companyId, movementId, scheduleId])
  @@index([companyId, scheduleId, reversedAt])
}

model FinancialTransfer {
  id                   String                  @id @default(cuid())
  companyId            String
  sourceAccountId      String
  destinationAccountId String
  amount               Decimal                 @db.Decimal(15, 2)
  currency             String                  @default("EUR")
  transferDate         DateTime
  status               FinancialTransferStatus @default(DRAFT)
  createdById          String
  completedById        String?
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceAccount        FinancialAccount        @relation("FinancialTransferSource", fields: [companyId, sourceAccountId], references: [companyId, id], onDelete: Restrict)
  destinationAccount   FinancialAccount        @relation("FinancialTransferDestination", fields: [companyId, destinationAccountId], references: [companyId, id], onDelete: Restrict)
  createdBy            User                    @relation("FinancialTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy          User?                   @relation("FinancialTransferCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  createdAt            DateTime                @default(now())
  completedAt          DateTime?

  @@unique([companyId, id])
  @@index([companyId, status, transferDate])
}

model BankStatement {
  id                 String              @id @default(cuid())
  companyId          String
  financialAccountId String
  statementDate      DateTime
  openingBalance     Decimal             @db.Decimal(15, 2)
  closingBalance     Decimal             @db.Decimal(15, 2)
  status             BankStatementStatus @default(IMPORTED)
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount    @relation(fields: [companyId, financialAccountId], references: [companyId, id], onDelete: Restrict)
  lines              BankStatementLine[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([companyId, financialAccountId, statementDate])
  @@unique([companyId, id])
  @@index([companyId, status, statementDate])
}

model BankStatementLine {
  id                   String               @id @default(cuid())
  companyId            String
  bankStatementId      String
  transactionDate      DateTime
  valueDate            DateTime?
  amount               Decimal              @db.Decimal(15, 2)
  description          String
  reference            String?
  matchedMovementId    String?
  reconciliationStatus ReconciliationStatus @default(UNMATCHED)
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankStatement        BankStatement        @relation(fields: [companyId, bankStatementId], references: [companyId, id], onDelete: Cascade)
  matchedMovement      FinancialMovement?   @relation(fields: [companyId, matchedMovementId], references: [companyId, id], onDelete: Restrict)
  createdAt            DateTime             @default(now())

  @@unique([companyId, id])
  @@unique([companyId, matchedMovementId])
  @@index([companyId, bankStatementId, reconciliationStatus])
}

model RestaurantArea {
  id          String            @id @default(cuid())
  companyId   String
  locationId  String
  code        String
  name        String
  description String?
  sortOrder   Int               @default(0)
  active      Boolean           @default(true)
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location    Location          @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  tables      RestaurantTable[]

  @@unique([companyId, locationId, code])
  @@unique([companyId, id])
  @@index([companyId, locationId, active, deletedAt])
}

model RestaurantTable {
  id           String                       @id @default(cuid())
  companyId    String
  locationId   String
  areaId       String
  code         String
  name         String
  seats        Int
  minSeats     Int?
  maxSeats     Int?
  shape        String?
  positionX    Decimal?                     @db.Decimal(10, 2)
  positionY    Decimal?                     @db.Decimal(10, 2)
  width        Decimal?                     @db.Decimal(10, 2)
  height       Decimal?                     @db.Decimal(10, 2)
  status       RestaurantTableStatus        @default(AVAILABLE)
  combinable   Boolean                      @default(true)
  active       Boolean                      @default(true)
  deletedAt    DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  company      Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location     Location                     @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  area         RestaurantArea               @relation(fields: [companyId, areaId], references: [companyId, id], onDelete: Restrict)
  reservations RestaurantReservationTable[]
  orders       RestaurantOrder[]

  @@unique([companyId, locationId, code])
  @@unique([companyId, id])
  @@index([companyId, locationId, status, deletedAt])
}

model RestaurantReservation {
  id                String                       @id @default(cuid())
  companyId         String
  locationId        String
  code              String
  partnerId         String?
  guestName         String
  phone             String?
  email             String?
  reservationDate   DateTime
  startTime         DateTime
  endTime           DateTime?
  partySize         Int
  status            RestaurantReservationStatus  @default(PENDING)
  source            RestaurantReservationSource  @default(MANUAL)
  notes             String?
  internalNotes     String?
  depositAmount     Decimal?                     @db.Decimal(15, 2)
  depositScheduleId String?
  createdById       String?
  updatedById       String?
  cancelledAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  company           Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location          Location                     @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  partner           Partner?                     @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict)
  depositSchedule   PaymentSchedule?             @relation(fields: [companyId, depositScheduleId], references: [companyId, id], onDelete: Restrict)
  tables            RestaurantReservationTable[]
  orders            RestaurantOrder[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@unique([companyId, depositScheduleId])
  @@index([companyId, locationId, reservationDate, status])
}

model RestaurantReservationTable {
  companyId     String
  reservationId String
  tableId       String
  createdAt     DateTime              @default(now())
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reservation   RestaurantReservation @relation(fields: [companyId, reservationId], references: [companyId, id], onDelete: Cascade)
  table         RestaurantTable       @relation(fields: [companyId, tableId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, reservationId, tableId])
  @@index([companyId, tableId])
}

model RestaurantMenu {
  id          String                  @id @default(cuid())
  companyId   String
  locationId  String?
  code        String
  name        String
  description String?
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean                 @default(true)
  deletedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location    Location?               @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  sections    RestaurantMenuSection[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, locationId, active, deletedAt])
}

model RestaurantMenuSection {
  id          String               @id @default(cuid())
  companyId   String
  menuId      String
  name        String
  description String?
  sortOrder   Int                  @default(0)
  active      Boolean              @default(true)
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  menu        RestaurantMenu       @relation(fields: [companyId, menuId], references: [companyId, id], onDelete: Cascade)
  items       RestaurantMenuItem[]

  @@unique([companyId, menuId, name])
  @@unique([companyId, id])
}

model RestaurantMenuItem {
  id            String                @id @default(cuid())
  companyId     String
  menuSectionId String
  itemId        String
  displayName   String?
  description   String?
  priceOverride Decimal?              @db.Decimal(15, 2)
  sortOrder     Int                   @default(0)
  available     Boolean               @default(true)
  featured      Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  section       RestaurantMenuSection @relation(fields: [companyId, menuSectionId], references: [companyId, id], onDelete: Cascade)
  item          Item                  @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, menuSectionId, itemId])
  @@index([companyId, itemId])
}

model RestaurantOrder {
  id            String                  @id @default(cuid())
  companyId     String
  locationId    String
  code          String
  reservationId String?
  tableId       String?
  partnerId     String?
  status        RestaurantOrderStatus   @default(OPEN)
  serviceType   RestaurantServiceType   @default(DINE_IN)
  openedAt      DateTime                @default(now())
  closedAt      DateTime?
  guestCount    Int                     @default(1)
  notes         String?
  documentId    String?
  paymentStatus RestaurantPaymentStatus @default(UNPAID)
  createdById   String?
  updatedById   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location      Location                @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  reservation   RestaurantReservation?  @relation(fields: [companyId, reservationId], references: [companyId, id], onDelete: Restrict)
  table         RestaurantTable?        @relation(fields: [companyId, tableId], references: [companyId, id], onDelete: Restrict)
  partner       Partner?                @relation(fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict)
  document      BusinessDocument?       @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  lines         RestaurantOrderLine[]
  tickets       KitchenTicket[]
  consumptions  RecipeConsumption[]

  @@unique([companyId, locationId, code])
  @@unique([companyId, id])
  @@unique([companyId, documentId])
  @@index([companyId, locationId, status])
}

model RestaurantOrderLine {
  id           String                        @id @default(cuid())
  companyId    String
  orderId      String
  itemId       String
  quantity     Decimal                       @db.Decimal(15, 3)
  unitPrice    Decimal                       @db.Decimal(15, 4)
  vatRateId    String
  status       RestaurantOrderLineStatus     @default(NEW)
  courseNumber Int?
  seatNumber   Int?
  notes        String?
  kitchenNotes String?
  sentAt       DateTime?
  startedAt    DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  company      Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  order        RestaurantOrder               @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict)
  item         Item                          @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  vatRate      VatRate                       @relation(fields: [companyId, vatRateId], references: [companyId, id], onDelete: Restrict)
  modifiers    RestaurantOrderLineModifier[]
  ticketLines  KitchenTicketLine[]
  consumptions RecipeConsumption[]

  @@unique([companyId, id])
  @@index([companyId, orderId, status])
}

model RestaurantOrderLineModifier {
  id          String              @id @default(cuid())
  companyId   String
  orderLineId String
  itemId      String?
  name        String
  priceDelta  Decimal             @default(0) @db.Decimal(15, 2)
  notes       String?
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  orderLine   RestaurantOrderLine @relation(fields: [companyId, orderLineId], references: [companyId, id], onDelete: Cascade)
  item        Item?               @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, orderLineId])
}

model KitchenStation {
  id          String                     @id @default(cuid())
  companyId   String
  locationId  String
  code        String
  name        String
  description String?
  active      Boolean                    @default(true)
  sortOrder   Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location    Location                   @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  assignments KitchenStationAssignment[]
  tickets     KitchenTicket[]

  @@unique([companyId, locationId, code])
  @@unique([companyId, id])
}

model KitchenStationAssignment {
  id               String         @id @default(cuid())
  companyId        String
  kitchenStationId String
  itemId           String?
  itemCategoryId   String?
  priority         Int            @default(0)
  active           Boolean        @default(true)
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  station          KitchenStation @relation(fields: [companyId, kitchenStationId], references: [companyId, id], onDelete: Cascade)
  item             Item?          @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  itemCategory     ItemCategory?  @relation(fields: [companyId, itemCategoryId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, kitchenStationId, active])
}

model KitchenTicket {
  id               String              @id @default(cuid())
  companyId        String
  locationId       String
  kitchenStationId String
  orderId          String
  status           KitchenTicketStatus @default(NEW)
  createdAt        DateTime            @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location         Location            @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  station          KitchenStation      @relation(fields: [companyId, kitchenStationId], references: [companyId, id], onDelete: Restrict)
  order            RestaurantOrder     @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict)
  lines            KitchenTicketLine[]

  @@unique([companyId, id])
  @@index([companyId, kitchenStationId, status, createdAt])
}

model KitchenTicketLine {
  id          String              @id @default(cuid())
  companyId   String
  ticketId    String
  orderLineId String
  status      KitchenTicketStatus @default(NEW)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ticket      KitchenTicket       @relation(fields: [companyId, ticketId], references: [companyId, id], onDelete: Cascade)
  orderLine   RestaurantOrderLine @relation(fields: [companyId, orderLineId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, ticketId, orderLineId])
  @@index([companyId, orderLineId])
}

model RecipeConsumption {
  id                  String              @id @default(cuid())
  companyId           String
  locationId          String
  orderId             String
  orderLineId         String
  recipeItemId        String
  inventoryMovementId String
  componentItemId     String
  quantity            Decimal             @db.Decimal(15, 3)
  createdAt           DateTime            @default(now())
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location            Location            @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  order               RestaurantOrder     @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict)
  orderLine           RestaurantOrderLine @relation(fields: [companyId, orderLineId], references: [companyId, id], onDelete: Restrict)
  recipeItem          Item                @relation("RecipeConsumptionRecipe", fields: [companyId, recipeItemId], references: [companyId, id], onDelete: Restrict)
  componentItem       Item                @relation("RecipeConsumptionComponent", fields: [companyId, componentItemId], references: [companyId, id], onDelete: Restrict)
  inventoryMovement   InventoryMovement   @relation(fields: [companyId, inventoryMovementId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, orderLineId, componentItemId])
  @@index([companyId, orderId])
  @@index([companyId, inventoryMovementId])
}
