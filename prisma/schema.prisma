generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PartnerType {
  COMPANY
  PERSON
}

enum ModuleCategory {
  CORE
  SHARED
  RESTAURANT
  BEAUTY
  HOTEL
}

enum ModuleStatus {
  AVAILABLE
  PLANNED
  FUTURE
}

model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  vatNumber String? @unique
  taxCode   String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  currency  String  @default("EUR")
  timezone  String  @default("Europe/Rome")
  locale    String  @default("it-IT")
  active    Boolean @default(true)
  logo      String?

  memberships Membership[]
  partners    Partner[]
  modules     CompanyModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModuleDefinition {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  category    ModuleCategory
  mandatory   Boolean        @default(false)
  status      ModuleStatus

  companies CompanyModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyModule {
  id String @id @default(cuid())

  companyId          String
  moduleDefinitionId String
  enabled            Boolean   @default(false)
  enabledAt          DateTime?
  disabledAt         DateTime?
  configuration      Json?

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  moduleDefinition ModuleDefinition @relation(fields: [moduleDefinitionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleDefinitionId])
  @@index([companyId, enabled])
  @@index([moduleDefinitionId])
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  active Boolean @default(true)

  emailVerified DateTime?
  image         String?
  lastLogin     DateTime?

  locale   String @default("it-IT")
  timeZone String @default("Europe/Rome")

  memberships Membership[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id String @id @default(cuid())

  userId    String
  companyId String

  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roles MembershipRole[]

  @@unique([userId, companyId])
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  system      Boolean @default(true)

  memberships MembershipRole[]
}

model MembershipRole {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model Account {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Partner {
  id String @id @default(cuid())

  type PartnerType @default(COMPANY)

  name        String
  displayName String?

  vatNumber String?
  taxCode   String?

  email String?
  pec   String?

  phone  String?
  mobile String?

  website String?

  address  String?
  zipCode  String?
  city     String?
  province String?
  country  String?

  isCustomer Boolean @default(false)
  isSupplier Boolean @default(false)

  active Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([name])
}
